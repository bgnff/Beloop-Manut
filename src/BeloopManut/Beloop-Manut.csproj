<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Beloop_Manut</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>

    <EmbeddedResource Include="Recursos\Imagens\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserva as credenciais locais do usuário e copia a configuração para o executável. -->
    <None Update="conexao.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>
</Project>
